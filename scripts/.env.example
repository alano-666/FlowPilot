# FlowPilot 配置模板：复制本文件为 .env.local（Mac/Linux 用 source 加载）或
# 按行设置为系统环境变量（Windows），填入实际值后启动即可。
# 不填也能启动：AI 走 Mock 演示模式，飞书/企微/邮件渠道禁用。

# ============ AI 大模型（必填其一，评审演示建议用中转站） ============
export FLOWPILOT_AI_PROVIDER=anthropic
# Anthropic 官方或第三方兼容网关（中转站）的 API Key
export FLOWPILOT_AI_ANTHROPIC_APIKEY=在这里填AI密钥
# 第三方网关地址（用官方 Anthropic API 时此行留空删除即可）
export FLOWPILOT_AI_ANTHROPIC_BASEURL=https://你的中转站地址/api/anthropic
# 模型名（网关支持列表可用 /v1/models 查询，如 deepseek-v4-pro）
export FLOWPILOT_AI_ANTHROPIC_MODEL=deepseek-v4-pro
# 第三方网关不执行服务端 Schema 校验，必须设 false；官方 API 保持 true
export FLOWPILOT_AI_ANTHROPIC_STRICTSCHEMA=false

# ============ 飞书（评审演示核心，创建应用见 docs/07） ============
export FLOWPILOT_FEISHU_APPID=在这里填AppID
export FLOWPILOT_FEISHU_APPSECRET=在这里填AppSecret
# 事件订阅开启加密时填写（飞书后台-事件与回调）
export FLOWPILOT_FEISHU_ENCRYPTKEY=
export FLOWPILOT_FEISHU_VERIFICATIONTOKEN=

# ============ 企业微信（可选） ============

# ============ 邮箱邮件（可选，用邮箱授权码） ============
export FLOWPILOT_EMAIL_ENABLED=false
export FLOWPILOT_EMAIL_IMAPHOST=
export FLOWPILOT_EMAIL_USERNAME=
export FLOWPILOT_EMAIL_PASSWORD=

# ============ 安全（生产必填） ============
# JWT 密钥（≥32 字节随机串）：openssl rand -base64 32
export FLOWPILOT_AUTH_JWTSECRET=
# 数据库列加密密钥（Base64 的 32 字节）：openssl rand -base64 32
export FLOWPILOT_DATA_ENCRYPTION_KEY=

# ============ 其他（一般不用改） ============
# export FLOWPILOT_SERVER_PORT=8080
# export FLOWPILOT_WECHAT_WATCHDIR=./data/watch
# export FLOWPILOT_NOTIFY_FEISHUWEBHOOK=
